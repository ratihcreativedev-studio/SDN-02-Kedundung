// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// -----------------------------------------------------------------------------
// USER & ROLE
// -----------------------------------------------------------------------------

model Profile {
  id        String   @id // Menggunakan ID dari auth.users Supabase
  name      String
  nip       String?
  position  String?
  role      String   @default("user") // "admin", "user", "parent"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  announcements   Announcement[]
  homeroomClasses Class[]        @relation("ClassHomeroom")

  @@map("profiles")
}

// -----------------------------------------------------------------------------
// CMS KONTEN SEKOLAH
// -----------------------------------------------------------------------------

model SchoolProfile {
  id           String   @id @default(cuid())
  description  String   @db.Text
  vision       String?  @db.Text
  mission      String?  @db.Text
  organization String?  @db.Text
  contactEmail String?
  contactPhone String?
  address      String?  @db.Text
  updatedAt    DateTime @updatedAt

  @@map("school_profiles")
}

model Announcement {
  id        String   @id @default(cuid())
  title     String
  content   String   @db.Text
  status    String   @default("PUBLISHED")
  thumbnail String?
  authorId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  author Profile @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@map("announcements")
}

model Gallery {
  id        String   @id @default(cuid())
  imageUrl  String
  caption   String?
  createdAt DateTime @default(now())

  @@map("galleries")
}

// -----------------------------------------------------------------------------
// DATA AKADEMIK
// -----------------------------------------------------------------------------

model Class {
  id         String   @id @default(cuid())
  name       String // misal: "Kelas 1", "Kelas 2A"
  homeroomId String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  ledgerReports    LedgerReport[]
  attendanceRecaps AttendanceRecap[]
  reports          StudentReport[]
  students         Student[]
  homeroom         Profile?          @relation("ClassHomeroom", fields: [homeroomId], references: [id], onDelete: SetNull)
  subjects         ClassSubject[]

  @@map("classes")
}

enum StudentStatus {
  active
  inactive
  graduate
}

model Student {
  id             String        @id @default(cuid())
  nisn           String        @unique
  name           String
  classId        String?
  status         StudentStatus @default(active)
  graduationDate DateTime?     @db.Date

  nipd       String?
  gender     String?
  birthPlace String?
  birthDate  DateTime? @db.Date
  nik        String?
  religion   String?
  address    String?   @db.Text
  village    String?
  district   String?
  fatherName String?
  fatherJob  String?
  motherName String?
  motherJob  String?
  ijazahUrl  String?
  note       String?   @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  class            Class?            @relation(fields: [classId], references: [id], onDelete: SetNull)
  reports          StudentReport[]
  grades           Grade[]
  ledgerReports    LedgerReport[]
  attendanceRecaps AttendanceRecap[]
  attendances      Attendance[]
  achievements     Achievement[]

  @@map("students")
}

model Subject {
  id        String   @id @default(cuid())
  name      String // misal: "Matematika", "Bahasa Indonesia"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  grades  Grade[]
  classes ClassSubject[]

  @@map("subjects")
}

model ClassSubject {
  id        String   @id @default(cuid())
  classId   String
  subjectId String
  createdAt DateTime @default(now())

  class   Class   @relation(fields: [classId], references: [id], onDelete: Cascade)
  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@unique([classId, subjectId])
  @@map("class_subjects")
}

model Grade {
  id        String   @id @default(cuid())
  studentId String
  subjectId String
  semester  String // misal: "Ganjil 2023/2024"
  uh        Float?
  asts      Float?
  asas      Float?
  // Legacy components retained without guessing their equivalence to the new format.
  uh1       Float?
  uh2       Float?
  uh3       Float?
  uas       Float?
  score     Float // Nilai Rapor, imported directly from Excel
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  // Seorang siswa hanya punya 1 nilai per mata pelajaran per semester
  @@unique([studentId, subjectId, semester])
  @@map("grades")
}

model Attendance {
  id        String   @id @default(cuid())
  studentId String
  monthYear String // "Januari 2026"
  hadir     Int
  sakit     Int
  izin      Int
  alpha     Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  // Seorang siswa hanya punya 1 catatan absensi per bulan per tahun
  @@unique([studentId, monthYear])
  @@map("attendances")
}

model Achievement {
  id        String    @id @default(cuid())
  studentId String
  title     String
  level     String
  rank      String?
  eventName String
  imageUrl  String?
  date      DateTime? @db.Date
  note      String?   @db.Text
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@map("achievements")
}

// -----------------------------------------------------------------------------
// Admin Access
// -----------------------------------------------------------------------------

model AdminWhitelist {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email     String   @unique
  name      String?
  role      String   @default("ADMIN") // SUPERADMIN atau ADMIN
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("admin_whitelist")
}

// Assessment components per student, subject and semester.
model StudentReport {
  id        String   @id @default(cuid())
  classId   String?
  studentId String
  subjectCode String @default("BI_ID")
  subjectName String @default("Bahasa Indonesia")
  semester  String
  uh        Float?
  asts      Float?
  asas      Float?
  score     Float
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  class   Class?  @relation(fields: [classId], references: [id], onDelete: SetNull)
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, subjectCode, semester])
  @@index([classId, semester])
  @@map("student_reports")
}

// Excel semester recap: NISN/NAMA identify the student; IJIN/ALPA map to izin/alpha.
model AttendanceRecap {
  id        String   @id @default(cuid())
  classId   String?
  studentId String
  semester  String
  hadir     Int
  sakit     Int
  izin      Int
  alpha     Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  class   Class?  @relation(fields: [classId], references: [id], onDelete: SetNull)
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, semester])
  @@index([classId, semester])
  @@map("attendance_recaps")
}

// Leger Excel: separate from the UH/ASTS/ASAS report and legacy subject grades.
model LedgerReport {
  id               String                       @id @default(cuid())
  classId          String?
  studentId        String
  semester         String
  sakit            Int?
  izin             Int?
  alpha            Int?
  createdAt        DateTime                     @default(now())
  updatedAt        DateTime                     @updatedAt
  class            Class?                       @relation(fields: [classId], references: [id], onDelete: SetNull)
  student          Student                      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  subjects         LedgerSubjectGrade[]
  extracurriculars LedgerExtracurricularGrade[]

  @@unique([studentId, semester])
  @@index([classId, semester])
  @@map("ledger_reports")
}

model LedgerSubjectGrade {
  id       String       @id @default(cuid())
  reportId String
  // Stable distinct keys for BI (Indonesia) and BI (Inggris).
  code     String
  name     String
  score    Float?
  report   LedgerReport @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@unique([reportId, code])
  @@map("ledger_subject_grades")
}

model LedgerExtracurricularGrade {
  id        String       @id @default(cuid())
  reportId  String
  code      String
  name      String
  predicate String?
  report    LedgerReport @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@unique([reportId, code])
  @@map("ledger_extracurricular_grades")
}

// Academic catalog; grade rows retain their code/name snapshots for historical reports.
model AcademicItem {
  id        String    @id @default(cuid())
  category  String
  code      String
  name      String
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([category, code])
  @@index([category, deletedAt])
  @@map("academic_items")
}
